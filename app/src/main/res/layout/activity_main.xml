<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/guide_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:accessibilityLiveRegion="polite"
            android:textSize="18sp" />

        <Button
            android:id="@+id/open_accessibility_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:minHeight="56dp"
            android:text="@string/open_accessibility_settings"
            android:textSize="18sp" />

        <Button
            android:id="@+id/open_practice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/open_practice"
            android:textSize="18sp" />

        <Button
            android:id="@+id/voice_command"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/voice_command"
            android:textSize="18sp" />

        <Button
            android:id="@+id/guide_contacts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/command_contacts"
            android:textSize="18sp" />

        <Button
            android:id="@+id/guide_youtube"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/command_youtube"
            android:textSize="18sp" />

        <Button
            android:id="@+id/guide_gov24"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/command_gov24"
            android:textSize="18sp" />

        <Button
            android:id="@+id/stop_guide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/stop_guide"
            android:textSize="18sp" />

        <Button
            android:id="@+id/sos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/sos"
            android:textSize="18sp" />
        <Button
            android:id="@+id/open_mock_guardian"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/open_mock_guardian"
            android:textSize="18sp"
            android:visibility="gone" />
        <Button
            android:id="@+id/open_dev_viewer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/open_dev_viewer"
            android:textSize="18sp"
            android:visibility="gone" />
        <Button
            android:id="@+id/check_firebase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            android:text="@string/firebase_check"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/firebase_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
