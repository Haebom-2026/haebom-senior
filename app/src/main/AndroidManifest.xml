<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- "○○ 열어 줘": 홈 화면에 보이는 앱 이름으로 찾아 바로 엶 -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <package android:name="com.google.android.youtube" />
        <package android:name="kr.go.minwon.m" />
        <package android:name="com.android.chrome" />
        <!-- 주변 장소 지도 검색 -->
        <package android:name="com.nhn.android.nmap" />
        <package android:name="net.daum.android.map" />
        <package android:name="com.google.android.apps.maps" />
        <!-- 금융 요청 뒤 [계속하기]로 열어 줄 은행 앱 (Sensitivity.FINANCE_APPS, SensitiveApps) -->
        <package android:name="viva.republica.toss" />
        <package android:name="com.kakaobank.channel" />
        <package android:name="com.kbstar.kbbank" />
        <package android:name="com.shinhan.sbanking" />
        <package android:name="com.wooribank.smart.npib" />
        <package android:name="com.kebhana.hanapush" />
        <package android:name="nh.smart.banking" />
        <package android:name="com.nonghyup.nhallonebank" />
        <package android:name="com.ibk.android.ionebank" />
        <package android:name="com.kbankwith.smartbank" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.INSERT" />
            <data android:mimeType="vnd.android.cursor.dir/contact" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>
    <application
        android:name=".HaebomApp"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".GuidePracticeActivity"
            android:exported="false" />
        <activity
            android:name=".GuideInputActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />
        <activity
            android:name=".family.FamilyActivity"
            android:exported="false" />
        <activity
            android:name=".family.ChallengeActivity"
            android:exported="false" />
        <service
            android:name=".family.HaebomMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <service
            android:name=".guide.GuideService"
            android:exported="true"
            android:label="@string/guide_service_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guide_accessibility_service" />
        </service>
    </application>
</manifest>
